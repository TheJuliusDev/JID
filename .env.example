# JID environment configuration
# Copy this file to ".env" and fill in real values.
# The app runs ONLY against a real backend — without these it shows a
# configuration screen instead of starting. See supabase/README.md.

# --- Supabase (Project Settings -> API) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Cloudinary (unsigned upload preset only — never the API secret) ---
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# The VITE_ prefix also works as a fallback, e.g.:
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
