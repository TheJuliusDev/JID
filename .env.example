# ==============================================================================
# JID — OAU Student Marketplace & Accommodation Platform
# Environment Variables Configuration
# ==============================================================================

# SUPABASE CONFIGURATION (Optional - App runs seamlessly in Demo Mode if missing)
# Obtain these from your Supabase project dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Also supports Next.js naming convention:
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# CLOUDINARY CONFIGURATION (Optional - App falls back to local previews if missing)
# Obtain these from your Cloudinary console -> Dashboard & Settings -> Upload presets
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Also supports Next.js naming convention:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
